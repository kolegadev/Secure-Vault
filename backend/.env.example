# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Security
SESSION_SECRET=change-this-to-a-32-char-secret-in-production!!!

# LUKS Configuration
LUKS_DEVICE_PATH=/dev/sdb1
LUKS_MOUNT_POINT=/mnt/openclaw-vault
LUKS_MAPPER_NAME=openclaw-vault

# USB Monitoring
USB_POLL_INTERVAL_MS=2000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
