NODE_ENV=development
PORT=3001
HOST=0.0.0.0
SESSION_SECRET=change-me-in-production

# Vault provider: 'luks' (legacy) or 'veracrypt' (v2)
VAULT_PROVIDER=luks

# V2 canonical vault settings (used by VeraCrypt and as primary source)
VAULT_MOUNT_POINT=/mnt/securevault
VAULT_DEVICE_PATH=/dev/sdb1

# LUKS settings (legacy fallback)
LUKS_DEVICE_PATH=/dev/sdb1
LUKS_MOUNT_POINT=/mnt/openclaw-vault
LUKS_MAPPER_NAME=openclaw-vault

USB_POLL_INTERVAL_MS=2000

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
