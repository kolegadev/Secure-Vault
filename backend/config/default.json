{
  "app": { "name": "OpenClaw Secure Vault", "version": "2.0.0-alpha" },
  "server": { "port": 3001, "host": "0.0.0.0" },
  "security": { "sessionTtlMinutes": 30, "csrfEnabled": true, "corsOrigin": "http://localhost:5173" },
  "vault": { "provider": "luks", "mountTimeoutMs": 30000 },
  "luks": { "devicePath": "/dev/sdb1", "mountPoint": "/mnt/openclaw-vault", "mapperName": "openclaw-vault", "filesystem": "ext4" },
  "usb": { "pollIntervalMs": 2000 },
  "paths": { "vaultDb": "vault.db", "envDir": "env", "skillsDir": "skills", "servicesDir": "services", "exportsDir": "exports" }
}
