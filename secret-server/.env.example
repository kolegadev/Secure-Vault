# OpenClaw Secret Server — Environment Configuration
# Copy to .env and adjust for your deployment.

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# Bind IP. In production tailscale_only=true overrides this with the
# Tailscale IP automatically. For local dev set tailscale_only=false and
# use 127.0.0.1.
SECRET_SERVER_HOST=127.0.0.1
SECRET_SERVER_PORT=8000

# When true, the server refuses to start unless a 100.x.x.x interface is found
# and binds to that IP exclusively.
SECRET_SERVER_TAILSCALE_ONLY=true

# ---------------------------------------------------------------------------
# Vault
# ---------------------------------------------------------------------------
SECRET_SERVER_VAULT_MOUNT_POINT=/mnt/securevault
SECRET_SERVER_VAULT_PROVIDER=veracrypt
SECRET_SERVER_VAULT_MOUNT_TIMEOUT=30

# ---------------------------------------------------------------------------
# Signing Agent
# ---------------------------------------------------------------------------
SECRET_SERVER_USE_SIGNING_AGENT=true
SECRET_SERVER_SIGNING_AGENT_SOCKET=/run/signing-agent/signing.sock
SECRET_SERVER_SIGNING_RATE_LIMIT_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
SECRET_SERVER_LOG_LEVEL=INFO
